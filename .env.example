# Copy to .env (never commit .env). Generate secrets with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
AUTH_SECRET=
MASTER_KEY=
PUBLIC_URL=http://localhost:3000
# Optional: send traces to any OTLP collector, e.g. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# For local development without Docker (pnpm dev), point DATABASE_URL at your Postgres, and allow
# the web dev server (pnpm dev:web) to sign in through its proxy:
DATABASE_URL=postgres://am:change-me@localhost:5432/am
TRUSTED_ORIGINS=http://localhost:5173
