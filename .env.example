# Copy to .env (never commit .env). Generate secrets with: openssl rand -base64 32

# Docker Compose only (the app does not read these three). AM_VERSION pins the released image so a
# restart or pull does not silently change versions; AM_PORT publishes the app on the host (the
# container still listens on 3000, so also update PUBLIC_URL/PUBLIC_LINKS_URL when you change it).
AM_VERSION=0.4.0
AM_PORT=3000
# Memory cap for the whole ClickHouse container (server, caches and query memory). It protects the
# host; ClickHouse's own limits (e.g. max_server_memory_usage) still apply inside it. 2g is a
# starting point for the single-node pilot; raise it for large imports or event volumes.
CLICKHOUSE_MEM_LIMIT=2g
# Source builds via docker-compose.build.yml tag the local image; uncomment to choose the tag.
# AM_BUILD_IMAGE=agentic-marketing:local

POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
AUTH_SECRET=
MASTER_KEY=
# During a master key rotation only: the old key(s), comma-separated. See docs/development.md.
MASTER_KEY_PREVIOUS=
# Backups. The app writes `am backup` output and the automatic pre-upgrade dump to BACKUP_DIR;
# docker-compose.yml sets it to /backups, where the `backups` volume is. The pre-upgrade dump is skipped with
# SKIP_PRE_UPGRADE_BACKUP=true (e.g. when an external backup job already covers Postgres); a
# missing pg_dump only logs a warning and never blocks a start. See docs/deployment/backups.md.
# BACKUP_DIR=/backups
SKIP_PRE_UPGRADE_BACKUP=false
# Scheduled backups (`am backup --schedule`, see compose.override.example.yaml): a standard
# 5-field cron in UTC, and how many days completed backups are kept (default 14).
# BACKUP_CRON="30 3 * * *"
# BACKUP_KEEP_DAYS=14
# CLI only (not server configuration): `cli bootstrap` and `cli reset-password` read the password
# from these when set, otherwise they prompt without echo or read one line from stdin.
# AM_BOOTSTRAP_PASSWORD=
# AM_RESET_PASSWORD=
# Public URL of the server. MCP (AI agents) requires HTTPS here: with a plain-HTTP address other
# than loopback (for development) the admin UI and REST API still work, but the MCP/OAuth client
# endpoints are disabled.
PUBLIC_URL=http://localhost:3000
# Public-only listener. When set, the server also listens on this port and serves only the public
# paths /f, /u, /c, /a, /n and /hooks (plus /healthz and /readyz); everything else is 404 there. The
# compose file publishes it on PUBLIC_BIND, the host side as host:port (compose only, not read by the
# app; default 127.0.0.1:3201, loopback only). A tunnel container on a Docker network points at
# http://app:3001 and needs no host port (see `ports: !override` in compose.override.example.yaml);
# a tunnel on another host uses e.g. 0.0.0.0:3001 (or a LAN address). Empty PUBLIC_PORT: no public
# listener, and nothing listens behind the published port.
# PUBLIC_PORT=3001
# PUBLIC_BIND=127.0.0.1:3201
# Directory with the built admin UI. The image includes apps/web/dist and serves it at `/`; set this
# to serve a different build (e.g. a mounted volume). Empty: apps/web/dist in the repo/image.
WEB_DIST=
# Links in e-mails and on websites (unsubscribe, clicks, signup forms, confirmations), when a site
# proxies them first-party, e.g. https://martechsignal.com/am. Empty: PUBLIC_URL.
PUBLIC_LINKS_URL=
# Client IP headers in trust order, comma-separated. Public traffic through a Cloudflare Tunnel
# sends cf-connecting-ip; admin/sign-in traffic on the LAN or VPN has no forwarding header and
# falls back to the socket address.
CLIENT_IP_HEADER=cf-connecting-ip,x-forwarded-for
# Comma-separated proxy or loopback ranges whose forwarding headers are trusted, e.g. the tunnel
# or reverse proxy. Empty trusts the headers from any source (backward compatible); set it to your
# proxy/loopback ranges in production.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,10.0.0.0/8
# Private hosts or ranges webhooks and connector actions may reach, e.g. n8n.lan,192.168.1.0/24
EGRESS_ALLOWED_HOSTS=
# Rewrite links in e-mails to count clicks (true/false)
EMAIL_TRACK_CLICKS=true
# Reject unknown command input keys with invalid_input instead of the default warn-first behaviour,
# where they are logged and returned in the result's warnings. Roll out with false, fix clients, then set true.
STRICT_INPUTS=false
# MCP tool result text: json (full result; default) or summary (one line, e.g. "artifacts.list: 12 artifacts").
# structuredContent always carries the full result.
MCP_TEXT_CONTENT=json
# MCP tool names: dotted command names such as artifacts.list (default), or underscore names such as
# artifacts_list for clients that do not accept dots.
MCP_TOOL_NAME_STYLE=dotted
# Largest file the asset library accepts (images and PDFs for e-mails and hosted pages), in bytes.
ASSET_MAX_BYTES=5242880
# Single sign-on: require a DNS TXT record proving each provider's domain (turn off only in development)
SSO_DOMAIN_VERIFICATION=true
# Where the key-encryption key lives: local (MASTER_KEY), openbao or aws-kms. See docs/deployment/kubernetes.md.
KEY_PROVIDER=local
# OPENBAO_ADDR=https://bao.internal:8200
# OPENBAO_TOKEN_FILE=/vault/secrets/token
# OPENBAO_TRANSIT_KEY=agentic-marketing
# AWS_KMS_KEY_ID=alias/agentic-marketing
# AWS_REGION=eu-north-1
# ClickHouse row policies limit every query to its workspace: required, auto or off
CLICKHOUSE_ROW_POLICIES=required
# How long the event bus (NATS JetStream) keeps events; they hold personal traits until processed.
NATS_RETENTION_HOURS=24
# Retention: remove signups never confirmed after N days; keep delivery and AI call logs N days
RETENTION_UNCONFIRMED_DAYS=30
RETENTION_LOG_DAYS=180
# Hours after an erasure in which events naming the erased person's identifiers are dropped instead
# of creating a new profile. After that, new activity is a new person; 0 still drops events from before the erasure, and nothing after it.
ERASURE_GRACE_HOURS=24
# Wrong passwords allowed when widening an API token, the window they count in, and the lockout
# after too many. Sign-in has its own rate limit; this protects the password step-up on token edits.
# STEP_UP_MAX_FAILURES=5
# STEP_UP_WINDOW_SECONDS=900
# STEP_UP_LOCKOUT_SECONDS=900
# Optional: send traces to any OTLP collector, e.g. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# For local development without Docker (pnpm dev), point DATABASE_URL at your Postgres, and allow
# the web dev server (pnpm dev:web) to sign in through its proxy:
DATABASE_URL=postgres://am:change-me@localhost:5432/am
TRUSTED_ORIGINS=http://localhost:5173
