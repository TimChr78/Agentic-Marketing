# Copy to .env.test to change the shared test stack's binds. Both scripts/test-services.sh and
# scripts/preflight.sh read this file; plain KEY=VALUE lines, no `export` needed.
#
# The defaults keep one machine-wide stack on these ports, shared by every checkout and delegate.
# AM_TEST_BIND_IP=0.0.0.0
# AM_TEST_PG_PORT=25432
# AM_TEST_CH_PORT=28123
# AM_TEST_VALKEY_PORT=26379
# AM_TEST_NATS_PORT=24222
# AM_TEST_OPENBAO_PORT=28200
#
# Optional profiles: AM_TEST_MAILPIT_PORT / AM_TEST_MAILPIT_SMTP_PORT, AM_TEST_GRAFANA_PORT.
#
# A second stack for verification, clear of the host's default ports:
# AM_TEST_PG_PORT=35432
# AM_TEST_CH_PORT=38123
# AM_TEST_VALKEY_PORT=36379
# AM_TEST_NATS_PORT=34222
# AM_TEST_OPENBAO_PORT=38200
