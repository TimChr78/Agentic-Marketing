{
  "name": "agentic-marketing",
  "private": true,
  "version": "0.14.8",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @agentic-marketing/server dev",
    "dev:web": "pnpm --filter @agentic-marketing/web dev",
    "build:demo": "pnpm --filter @agentic-marketing/web build:single",
    "migrate": "pnpm --filter @agentic-marketing/server cli migrate",
    "lint": "biome check . && node scripts/check-e2e-selectors.mjs && node scripts/changelog.mjs check",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --filter './packages/*' --filter './apps/*' typecheck",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:dev": "playwright test",
    "e2e:smoke": "scripts/e2e-docker.sh smoke",
    "e2e:functional": "scripts/e2e-docker.sh functional",
    "e2e:axe": "scripts/e2e-docker.sh axe",
    "e2e:visual": "playwright test -c playwright.visual.config.ts",
    "e2e:visual:docker": "scripts/e2e-docker.sh visual",
    "e2e:visual:update": "scripts/e2e-docker.sh update",
    "e2e:shots": "scripts/e2e-docker.sh shots",
    "e2e:selectors": "node scripts/check-e2e-selectors.mjs",
    "shots": "node e2e/screenshots.mjs reports/shots",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "test:clean": "tsx apps/server/test/clean.ts",
    "test:affected": "node scripts/test-affected.mjs --run",
    "test:affected:print": "node scripts/test-affected.mjs --print"
  },
  "pnpm": {
    "overrides": {
      "@types/mjml-core": "5.1.0",
      "glob": "14.0.2",
      "happy-dom": "^21.0.4",
      "minimatch": "11.0.1",
      "mjml-browser": "5.4.1",
      "smtp-server>nodemailer": "10.1.4",
      "@better-auth/sso>fast-xml-parser": "5.12.0"
    },
    "auditConfig": {
      "ignoreGhsas": ["GHSA-w5hq-g745-h8pq"]
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  }
}
