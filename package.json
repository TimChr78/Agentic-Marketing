{
  "name": "agentic-marketing",
  "private": true,
  "version": "0.6.1",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @agentic-marketing/server dev",
    "dev:web": "pnpm --filter @agentic-marketing/web dev",
    "build:demo": "pnpm --filter @agentic-marketing/web build:single",
    "migrate": "pnpm --filter @agentic-marketing/server cli migrate",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --filter './packages/*' --filter './apps/*' typecheck",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:dev": "playwright test",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "test:clean": "tsx apps/server/test/clean.ts"
  },
  "pnpm": {
    "overrides": {
      "@types/mjml-core": "5.1.0",
      "@better-auth/oauth-provider": "1.7.7",
      "@better-auth/core": "1.7.7",
      "better-auth": "1.7.7",
      "glob": "14.0.2",
      "happy-dom": "^21.0.4",
      "minimatch": "11.0.1",
      "mjml-browser": "5.4.1"
    },
    "auditConfig": {
      "ignoreGhsas": ["GHSA-w5hq-g745-h8pq"]
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  }
}
