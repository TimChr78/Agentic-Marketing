    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4"
  },
  "dependencies": {
